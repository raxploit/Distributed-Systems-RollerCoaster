# Tailnet-IP der VM, auf der Station + Wagen laufen (nicht die Laptop-IP!)
STATION_HOST=100.x.y.z
STATION_PORT=9090

# Kapazität c der Station und Anzahl der Wagen
CAPACITY=4
WAGONS=4

# Fahrtdauer und simulierte Boardingzeit in ms
RIDE_MS=3000
BOARDING_MS=0

# Passagiere auf dem Laptop
PASSENGERS=10
PAUSE_MS=500
ID_OFFSET=0

# SSH-Zugriff auf die VM. VM_HOST defaultet auf STATION_HOST.
# VM_HOST=100.x.y.z
VM_USER=arch
VM_REPO_DIR=/projects/Distributed-Systems-RollerCoaster
