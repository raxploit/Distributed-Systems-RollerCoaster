# Tailnet-IP des Präsentationslaptops (Station läuft dort nativ)
STATION_HOST=100.x.y.z
STATION_PORT=9090

# Kapazität c der Station und Anzahl der Wagen auf dem Laptop
CAPACITY=4
WAGONS=4

# Feste Fahrtdauer in ms (Station zeigt daraus den echten Fortschritt)
RIDE_MS=20000

# Türen-zu-Pause nach vollem Wagen in ms
BOARDING_MS=5000

# Pause zwischen dem Start zweier Wagen, damit die ersten arrive()-RPCs geordnet ankommen
WAGON_STAGGER_MS=400

# Passagiere auf der VM: zufällige Ankunft 1-5 s vor dem Einsteigen
PASSENGERS=20
BOARD_MIN_MS=1000
BOARD_MAX_MS=5000
PAUSE_MS=0
ID_OFFSET=0
